// Magura — social spot trading terminal. FIND.TRADE.REPEAT
// Spot only: there are no perp/leverage models by design.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Chain {
  solana
  base
  bsc
  ethereum
}

// ───────────────────────── Users & identity ─────────────────────────

model User {
  id          String   @id @default(cuid())
  privyId     String   @unique
  handle      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  email       String?  @unique
  experience  String? // new | some | pro
  interests   String[]
  badges      String[] // e.g. TOP_1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets       Wallet[]
  settings      UserSettings?
  followers     Follow[]           @relation("following")
  following     Follow[]           @relation("follower")
  messages      Message[]
  groupMembers  GroupMember[]
  ownedGroups   Group[]            @relation("groupOwner")
  dmMembers     DmMember[]
  trades        Trade[]
  copyAsLeader  CopySubscription[] @relation("leader")
  copyAsCopier  CopySubscription[] @relation("copier")
  notifications Notification[]
  pushSubs      PushSubscription[]
  streams       Stream[]
  callMembers   CallParticipant[]
  calls         Call[]             @relation("callCreator")
  reactions     Reaction[]
  reports       Report[]           @relation("reporter")
  trackedWallets TrackedWallet[]
  orderRules     OrderRule[]
  invitedBy      Referral?      @relation("invitee")
  invites        Referral[]     @relation("inviter")
  rewards        RewardEntry[]
  rewardClaims   RewardClaim[]
  priceAlerts    PriceAlert[]
  walletCopies   WalletCopy[]
  watchlist     WatchItem[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  chainKind String // svm | evm
  address   String
  label     String?
  isPrimary Boolean  @default(false)
  /// Privy embedded/server wallet id — required for delegated copy-trading execution.
  privyWalletId String?
  /// User granted Magura a session signer for copy-trading on this wallet.
  delegated Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chainKind, address])
  @@index([userId])
}

model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // profile visibility
  publicPnl     Boolean @default(true)
  showHoldings  Boolean @default(false)
  copyable      Boolean @default(true)
  // privacy & chat
  dmsFromAnyone Boolean @default(true)
  showInWorld   Boolean @default(true)
  readReceipts  Boolean @default(false)
  autoJoinVoice Boolean @default(false)
  hideBalanceOnStream Boolean @default(true)
  // trading
  quickBuyAmounts Json @default("{\"solana\":\"0.5\",\"base\":\"0.01\",\"bsc\":\"0.05\",\"ethereum\":\"0.01\"}")
  slippageBps     Int  @default(100)
  /// Instant-trade presets P1–P3: [{ name, slippageBps, buy: { <chain>: string[4] }, sell: number[4] }]
  tradePresets    Json?
  activePreset    Int  @default(0)
  /// Telegram chat linked for alerts
  telegramChatId  String?
  /// Personal code shown in every Telegram alert, so users can spot fake messages
  antiPhishingCode String?
  // copy defaults
  copyBudgetUsd       Decimal @default(0) @db.Decimal(18, 2)
  copyMaxPerBuyUsd    Decimal @default(250) @db.Decimal(18, 2)
  copyStopLossPct     Int     @default(20)
  copySells           Boolean @default(true)
  copyMemecoins       Boolean @default(false)
  copyBuyExisting     Boolean @default(false)
  copyConfirmAboveUsd Decimal @default(500) @db.Decimal(18, 2)
  // notifications: { event: { push: bool, app: bool } }
  notifications Json @default("{\"copy\":{\"push\":true,\"app\":true},\"call\":{\"push\":true,\"app\":true},\"dm\":{\"push\":true,\"app\":true},\"live\":{\"push\":false,\"app\":true},\"price\":{\"push\":true,\"app\":false},\"group\":{\"push\":false,\"app\":true}}")
}

/// "Tell me when $X goes above/below …" — price or market cap.
model PriceAlert {
  id           String    @id @default(cuid())
  userId       String
  chain        Chain
  tokenAddress String
  tokenSymbol  String
  metric       String // price | mc
  direction    String // above | below
  value        Float
  status       String    @default("active") // active | fired | cancelled
  firedAt      DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, status])
}

/// Server-generated keys the app needs at runtime (e.g. web-push VAPID), so nobody has to copy secrets around.
model AppKey {
  name      String   @id
  value     String
  createdAt DateTime @default(now())
}

/// A wallet a user watches (any wallet on-chain, not just Magura users).
model TrackedWallet {
  id        String   @id @default(cuid())
  userId    String
  chainKind String // svm | evm
  address   String
  label     String
  alerts    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chainKind, address])
  @@index([chainKind, address])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// ───────────────────────── Tokens & trades ─────────────────────────

model Token {
  chain      Chain
  address    String
  symbol     String
  name       String
  decimals   Int?
  imageUrl   String?
  launchpad  String? // pumpfun | clanker | fourmeme | flap | pons
  creator    String?
  stage      String   @default("new") // new | almost | survived
  bondingPct Float?
  migratedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // latest snapshot (refreshed by trenches worker)
  marketCapUsd Float?
  volumeUsd    Float?
  liquidityUsd Float?
  holders      Int?
  buys         Int?
  sells        Int?
  priceUsd     Float?
  priceChange1h  Float?
  priceChange24h Float?
  /// DEX the main pair trades on (raydium, pumpswap, uniswap, …)
  dex          String?
  volume5m     Float?
  buys5m       Int?
  sells5m      Int?
  hasX         Boolean @default(false)
  hasTelegram  Boolean @default(false)
  hasWebsite   Boolean @default(false)
  pairAddress  String?
  risk         Json? // TokenRisk from GoPlus
  riskCheckedAt DateTime?
  /// TokenIntel: supply split by wallet type, built from the launch trade stream
  intel        Json?
  athMarketCapUsd Float?
  /// when the dev last sold (drives "sell on dev sell" automations)
  devSoldAt    DateTime?
  /// team paid DexScreener for a profile / boost
  dexPaid      Boolean  @default(false)

  @@id([chain, address])
  @@index([creator])
  @@index([stage, createdAt])
  @@index([chain, stage, createdAt])
}

/// Every executed spot trade (manual, quick-buy, or copied).
model Trade {
  id          String   @id @default(cuid())
  userId      String
  chain       Chain
  side        String // buy | sell
  tokenAddress String
  tokenSymbol String
  amountIn    String // base units
  amountOut   String
  amountUsd   Decimal? @db.Decimal(18, 2)
  priceUsd    Float?
  /// Magura platform fee charged on this trade (size-tiered, in native coin)
  feeBps      Int?
  feeUsd      Decimal? @db.Decimal(18, 4)
  provider    String // jupiter | kyberswap | openocean | pumpportal
  txHash      String?
  status      String   @default("pending") // pending | confirmed | failed
  source      String   @default("manual") // manual | quickbuy | copy | call
  copyExecutionId String? @unique
  sharedToRoom String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  copyExecution CopyExecution? @relation(fields: [copyExecutionId], references: [id])

  @@index([userId, createdAt])
  @@index([chain, tokenAddress])
}

// ───────────────────────── Referrals ─────────────────────────

/// Who invited whom. Invitees pay 10% less in fees; inviters earn 25% of what invitees pay.
model Referral {
  inviteeId String   @id
  inviterId String
  createdAt DateTime @default(now())
  invitee   User     @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter   User     @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

/// One reward line per fee-paying trade: a referral share for the inviter, or cashback for the trader.
model RewardEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("referral") // referral | cashback
  inviteeId String
  /// the trade id (referral) or "cb:<trade id>" (cashback) — one line of each kind per trade
  tradeId   String   @unique
  chain     Chain
  feeUsd    Decimal  @db.Decimal(18, 4)
  rewardUsd Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A request to pay out earned rewards.
model RewardClaim {
  id        String   @id @default(cuid())
  userId    String
  amountUsd Decimal  @db.Decimal(18, 2)
  wallet    String
  chain     Chain
  status    String   @default("requested") // requested | paid | rejected
  txHash    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Automatic orders: take profit, stop loss, trailing stop, limit buy.
model OrderRule {
  id           String    @id @default(cuid())
  userId       String
  chain        Chain
  tokenAddress String
  tokenSymbol  String
  /// tp | sl | trail | trail_tp | limit_buy | dca | dev_sell | dev_sell_buy | migrate_buy | migrate_sell | dev_snipe
  /// dev_snipe: tokenAddress holds the dev wallet to watch
  kind         String
  /// tp: +% above entry · sl: −% below entry (stored negative) · trail: % drop from the peak
  triggerPct   Float?
  /// limit_buy: buy when market cap is at or below this
  triggerMcUsd Float?
  /// tp / sl / trail: % of the position to sell when it fires
  sellPct      Int?
  /// limit_buy: native amount to spend
  buyAmount    String?
  entryPrice   Float?
  peakPrice    Float?
  /// trail_tp: arm once price is up this % from entry, then trail by triggerPct
  armPct       Float?
  armed        Boolean   @default(false)
  /// dca: buy buyAmount every intervalSec, slicesTotal times, only while MC is within [minMcUsd, triggerMcUsd]
  intervalSec  Int?
  slicesTotal  Int?
  slicesDone   Int       @default(0)
  nextAt       DateTime?
  minMcUsd     Float?
  slippageBps  Int       @default(1500)
  status       String    @default("active") // active | executing | awaiting_confirm | done | failed | cancelled
  error        String?
  txHash       String?
  triggeredAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, chain])
  @@index([userId, status])
}

// ───────────────────────── Copy trading (spot) ─────────────────────────

model CopySubscription {
  id         String   @id @default(cuid())
  leaderId   String
  copierId   String
  mode       String   @default("proportional") // proportional | fixed
  budgetUsd  Decimal  @db.Decimal(18, 2)
  fixedAmountUsd Decimal? @db.Decimal(18, 2)
  maxPerBuyUsd Decimal @db.Decimal(18, 2)
  stopLossPct Int     @default(20)
  copySells  Boolean  @default(true)
  memecoins  Boolean  @default(false)
  buyExisting Boolean @default(false)
  confirmAboveUsd Decimal @default(500) @db.Decimal(18, 2)
  chains     Chain[]
  status     String   @default("active") // active | paused | stopped
  stoppedReason String?
  realizedPnlUsd Decimal @default(0) @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  leader     User     @relation("leader", fields: [leaderId], references: [id], onDelete: Cascade)
  copier     User     @relation("copier", fields: [copierId], references: [id], onDelete: Cascade)
  executions CopyExecution[]

  @@unique([leaderId, copierId])
  @@index([leaderId, status])
}

model CopyExecution {
  id             String   @id @default(cuid())
  subscriptionId String
  leaderTradeId  String
  side           String
  chain          Chain
  tokenAddress   String
  tokenSymbol    String
  amountUsd      Decimal  @db.Decimal(18, 2)
  status         String   @default("queued") // queued | awaiting_confirm | executing | done | skipped | failed
  skipReason     String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscription   CopySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  trade          Trade?

  @@unique([subscriptionId, leaderTradeId])
  @@index([status])
}

// ───────────────────────── Chat ─────────────────────────

/// One table for every room: world, coin rooms, group channels, DMs, stream chat.
model Room {
  id        String   @id // see roomIds in @magura/shared
  kind      String // world | coin | channel | dm | stream
  title     String?
  chain     Chain?
  tokenAddress String?
  channelId String?  @unique
  slowModeSec Int    @default(0)
  createdAt DateTime @default(now())
  messages  Message[]
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dmMembers DmMember[]
}

model Message {
  id         String   @id @default(cuid())
  roomId     String
  authorId   String
  text       String
  attachment Json?
  replyToId  String?
  editedAt   DateTime?
  deletedAt  DateTime?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  Reaction[]

  @@index([roomId, createdAt])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model DmMember {
  roomId   String
  userId   String
  lastReadAt DateTime?
  muted    Boolean @default(false)
  accepted Boolean @default(true) // false = message request
  room     Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

// ───────────────────────── Groups ─────────────────────────

model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  color       String   @default("#9D8CFF")
  isPublic    Boolean  @default(true)
  ownerId     String
  rules       String?
  createdAt   DateTime @default(now())
  owner       User     @relation("groupOwner", fields: [ownerId], references: [id])
  members     GroupMember[]
  channels    Channel[]
}

model GroupMember {
  groupId  String
  userId   String
  role     String   @default("member") // owner | lead | member
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Channel {
  id       String  @id @default(cuid())
  groupId  String
  name     String
  topic    String?
  kind     String  @default("text") // text | calls | voice
  position Int     @default(0)
  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room     Room?
  calls    Call[]

  @@unique([groupId, name])
}

// ───────────────────────── Calls & streams (Cloudflare Realtime) ─────────────────────────

model Call {
  id        String   @id @default(cuid())
  kind      String // dm | voice_room | group
  video     Boolean  @default(false)
  roomId    String? // DM room for 1:1 calls
  channelId String?
  creatorId String
  /// Cloudflare Realtime session/room reference
  cfRoom    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  creator   User     @relation("callCreator", fields: [creatorId], references: [id])
  channel   Channel? @relation(fields: [channelId], references: [id])
  participants CallParticipant[]
}

model CallParticipant {
  callId    String
  userId    String
  cfSessionId String?
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  sharingScreen Boolean @default(false)
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
}

model Stream {
  id         String   @id @default(cuid())
  hostId     String
  title      String
  tags       String[] // token tags like solana:<mint>
  status     String   @default("live") // scheduled | live | ended
  cfSessionId String?
  /// WHIP ingest / WHEP playback via Cloudflare Realtime/Stream
  whipUrl    String?
  whepUrl    String?
  viewers    Int      @default(0)
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  host       User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
}

// ───────────────────────── Notifications & moderation ─────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String // copy | call | dm | live | price | group
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetKind String // message | user | stream | group
  targetId   String
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())
  reporter   User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  title       String
  url         String   @unique
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}

/// Coins a user starred (Watchlist).
model WatchItem {
  userId    String
  chain     Chain
  address   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chain, address])
}

/// Copy any on-chain wallet (GMGN "WalletCopy"): mirrors its pump.fun buys/sells from the live feed.
model WalletCopy {
  id         String   @id @default(cuid())
  userId     String
  chain      Chain    @default(solana)
  wallet     String
  label      String
  /// fixed = buyAmount each time; ratio = ratioPct% of their size, capped at buyAmount
  buyMode    String   @default("fixed")
  buyAmount  String
  ratioPct   Int?
  /// copy = sell the same share they sold; none = never sell (use TP/SL)
  sellMode   String   @default("copy")
  minMcUsd   Float?
  maxMcUsd   Float?
  maxAgeMin  Int?
  buyOnce    Boolean  @default(true)
  skipAddOn  Boolean  @default(true)
  blacklist  String[] @default([])
  tpPct      Float?
  slPct      Float?
  slippageBps Int     @default(2500)
  status     String   @default("active") // active | paused
  buys       Int      @default(0)
  sells      Int      @default(0)
  skipped    Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, wallet])
  @@index([wallet, status])
}
