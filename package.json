{
  "name": "magura",
  "private": true,
  "version": "0.1.0",
  "description": "Magura — social spot trading terminal. FIND.TRADE.REPEAT",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "dev:api": "pnpm --filter @magura/api dev",
    "dev:web": "pnpm --filter @magura/web dev",
    "build": "pnpm --filter @magura/shared build && pnpm --filter @magura/chains build && pnpm --filter @magura/db build && pnpm --filter @magura/api build && pnpm --filter @magura/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @magura/db generate",
    "db:migrate": "pnpm --filter @magura/db migrate",
    "db:deploy": "pnpm --filter @magura/db deploy",
    "db:seed": "pnpm --filter @magura/db seed",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:e2e": "pnpm --filter @magura/web test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
