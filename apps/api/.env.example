# ── Core ──
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://magura:magura@localhost:5432/magura
REDIS_URL=redis://localhost:6379

# ── Auth (Privy) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key for server-side (delegated) wallet actions used by copy-trading
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Local only: lets requests authenticate with "x-dev-user: <handle>" (never in production)
DEV_AUTH=1

# ── RPC ──
HELIUS_RPC_URL=
QUICKNODE_SOLANA_URL=
QUICKNODE_BASE_URL=
QUICKNODE_BSC_URL=
QUICKNODE_ETHEREUM_URL=

# ── Swaps & data ──
JUPITER_API_KEY=
KYBERSWAP_CLIENT_ID=magura
GOPLUS_ACCESS_TOKEN=
BITQUERY_API_KEY=

# ── Launchpads (BNB/Pons: port factory + event from the old terminal) ──
TRENCHES_WORKER=1
FOURMEME_FACTORY=
FOURMEME_CREATE_EVENT=
FLAP_FACTORY=
FLAP_CREATE_EVENT=
PONS_CHAIN=bsc
PONS_FACTORY=
PONS_CREATE_EVENT=

# ── Realtime calls & streams (Cloudflare Realtime SFU) ──
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# ── Moderation ──
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ── Web Push ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@magura.app

# ── Observability ──
SENTRY_DSN=
